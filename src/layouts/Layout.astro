---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="GNEDHub - The Connected World" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-950 text-slate-200 min-h-screen flex flex-col font-sans antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
        <!-- Ambient background glow -->
        <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
            <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-cyan-900/10 blur-[120px]"></div>
            <div class="absolute bottom-[-20%] right-[-10%] w-[40%] h-[40%] rounded-full bg-cyan-800/10 blur-[100px]"></div>
        </div>

        <nav class="sticky top-0 z-50 bg-slate-950/60 backdrop-blur-md border-b border-white/5">
            <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
                <a href="/" class="text-xl font-semibold tracking-tight text-white flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.6)]"></div>
                    GNEDHub
                </a>
                <div class="flex items-center gap-8">
                    <a href="/" class="text-sm font-medium text-slate-400 hover:text-cyan-400 transition-colors">Home</a>
                    <a href="/modules" class="text-sm font-medium text-slate-400 hover:text-cyan-400 transition-colors">Modules</a>
                    <a href="/about" class="text-sm font-medium text-slate-400 hover:text-cyan-400 transition-colors">About</a>
                </div>
            </div>
        </nav>
        
        <main class="flex-grow w-full max-w-6xl mx-auto px-6 py-12 flex flex-col">
		    <slot />
        </main>

        <footer class="border-t border-white/5 py-8 text-center text-slate-500 text-xs tracking-wider">
            <p>&copy; {new Date().getFullYear()} GNED07 &middot; The Connected World</p>
        </footer>
	</body>
</html>