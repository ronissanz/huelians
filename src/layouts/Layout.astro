---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="GNED Subject Materials and Resources" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts: Outfit -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<ClientRouter />
	</head>
	<body class="bg-slate-950 text-slate-200 antialiased min-h-screen selection:bg-cyan-500/30 relative overflow-x-hidden">
		
		<!-- Dynamic Background Elements -->
		<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
			<!-- Glowing Orbs -->
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-cyan-600/20 blur-[120px] animate-pulse mix-blend-screen" style="animation-duration: 8s;"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[150px] animate-pulse mix-blend-screen" style="animation-duration: 12s; animation-delay: 2s;"></div>
		</div>
		
		<!-- Navigation Bar -->
		<nav class="fixed top-0 w-full z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-md">
			<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="text-xl font-bold tracking-tight text-white">
					GNED<span class="text-cyan-400">Hub</span>
				</a>
				<div class="flex gap-6 text-sm font-medium text-slate-400">
					<a href="/" class="hover:text-white transition-colors">Home</a>
					<a href="/modules" class="hover:text-white transition-colors">Modules</a>
					<a href="/about" class="hover:text-white transition-colors">About</a>
				</div>
			</div>
		</nav>

		<!-- Main Content Area -->
		<div class="pt-24 pb-12 px-6 max-w-5xl mx-auto">
			<slot />
		</div>

	</body>
</html>