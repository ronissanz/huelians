---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="GNED Subject Materials and Resources" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-950 text-slate-200 antialiased min-h-screen selection:bg-cyan-500/30">
		
		<!-- Navigation Bar -->
		<nav class="fixed top-0 w-full z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-md">
			<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="text-xl font-bold tracking-tight text-white">
					GNED<span class="text-cyan-400">Hub</span>
				</a>
				<div class="flex gap-6 text-sm font-medium text-slate-400">
					<a href="/" class="hover:text-white transition-colors">Home</a>
					<a href="/modules" class="hover:text-white transition-colors">Modules</a>
					<a href="/about" class="hover:text-white transition-colors">About</a>
				</div>
			</div>
		</nav>

		<!-- Main Content Area -->
		<div class="pt-24 pb-12 px-6 max-w-5xl mx-auto">
			<slot />
		</div>

	</body>
</html>