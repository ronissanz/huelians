---
import '../styles/global.css'; // This imports Tailwind globally

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A glorified, beautiful landing page" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-900 text-slate-100 antialiased min-h-screen">
		<!-- The <slot /> is where your page content will be injected -->
		<slot />
	</body>
</html>