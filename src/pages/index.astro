---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Beautiful Landing Page">
	<main class="flex flex-col items-center justify-center min-h-screen p-8 text-center">
		
		<div class="max-w-3xl space-y-8">
			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
				Build Something Stunning.
			</h1>
			
			<p class="text-lg md:text-xl text-slate-400 leading-relaxed">
				This is a blazingly fast, glorified landing page built with Astro and Tailwind CSS. No bloat, no backend, just pure performance and aesthetic design.
			</p>
			
			<div class="flex items-center justify-center gap-4 pt-4">
				<a href="#" class="px-8 py-3 rounded-full bg-blue-600 text-white font-semibold hover:bg-blue-500 transition-colors shadow-lg shadow-blue-500/30">
					Get Started
				</a>
				<a href="#" class="px-8 py-3 rounded-full bg-slate-800 text-slate-300 font-semibold hover:bg-slate-700 transition-colors border border-slate-700">
					Learn More
				</a>
			</div>
		</div>

	</main>
</Layout>