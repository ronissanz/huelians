---
import Layout from '../layouts/Layout.astro';
import FunFactSwiper from '../components/FunFactSwiper.tsx';
import { BookOpen, FileText, PlayCircle, ExternalLink } from 'lucide-react';
---

<Layout title="DEEPed | The Global Economy">
    <div class="max-w-6xl mx-auto px-6 pt-32 pb-24">
        <div class="text-center animate-fade-in relative z-10">
            <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-slate-900 dark:text-white mb-6 leading-tight max-w-4xl mx-auto">
                The mechanics of the global economy, <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-cyan-400 dark:from-cyan-400 dark:to-cyan-200">decoded.</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-10 font-light leading-relaxed">
                How GDP, inflation, central banks, and global trade actually dictate the world around you.
            </p>
            <a href="/modules" class="inline-flex items-center justify-center px-8 py-3 text-sm font-semibold text-cyan-700 dark:text-cyan-300 transition-all duration-200 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-white/60 dark:border-white/5 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.3)] hover:-translate-y-0.5 hover:shadow-lg hover:border-cyan-200 dark:hover:border-cyan-700">
                Begin the Course
            </a>
        </div>

        <FunFactSwiper client:load />

        <!-- Supplemental Resources -->
        <div class="mt-32">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-3">
                <div class="w-1.5 h-6 bg-cyan-500 rounded-full"></div>
                Supplemental Resources
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                <!-- Video Spotlight -->
                <a href="https://www.youtube.com/watch?v=PHe0bXAIuk0" target="_blank" rel="noopener noreferrer" class="md:col-span-8 group block bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-white/60 dark:border-white/5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.3)] rounded-3xl overflow-hidden hover:border-cyan-300 dark:hover:border-cyan-700 transition-all duration-300 cursor-pointer">
                    <div class="flex flex-col sm:flex-row h-full">
                        <!-- Left-side contextual preview/skeleton -->
                        <div class="sm:w-2/5 bg-slate-100/50 dark:bg-slate-800/50 border-r border-slate-200/50 dark:border-slate-700/50 relative flex items-center justify-center min-h-[200px] overflow-hidden">
                            <!-- Gridlines backdrop -->
                            <div class="absolute inset-0" style="background-image: linear-gradient(to right, rgba(6,182,212,0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(6,182,212,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
                            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 to-transparent"></div>
                            
                            <div class="w-16 h-16 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:shadow-cyan-500/20 transition-all z-10 border border-slate-100 dark:border-slate-700">
                                <PlayCircle className="text-cyan-500 ml-1" size={32} />
                            </div>
                        </div>
                        
                        <!-- Content -->
                        <div class="sm:w-3/5 p-8 flex flex-col justify-center">
                            <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-widest mb-3">Video Spotlight</span>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 leading-tight">How The Economic Machine Works (Ray Dalio)</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400 font-light leading-relaxed mb-6">
                                An incredibly clear, visually engaging 30-minute breakdown by billionaire investor Ray Dalio on how credit, interest rates, and the global economic engine actually function.
                            </p>
                            <div class="flex items-center gap-2 text-cyan-600 dark:text-cyan-400 text-sm font-semibold">
                                Watch Documentary <ExternalLink size={16} />
                            </div>
                        </div>
                    </div>
                </a>

                <!-- Articles / Books -->
                <div class="md:col-span-4 flex flex-col gap-8">
                    <div class="bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-white/60 dark:border-white/5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.3)] rounded-3xl p-6 flex-1">
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-8 h-8 rounded-lg bg-cyan-50 dark:bg-cyan-900/30 flex items-center justify-center">
                                <FileText className="text-cyan-500" size={16} />
                            </div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Featured Articles</h3>
                        </div>
                        <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-3">
                            <li>
                                <a href="https://hbr.org/2020/09/global-supply-chains-in-a-post-pandemic-world" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors flex items-start gap-2">
                                    <span class="text-cyan-500 mt-1">&rarr;</span> HBR: Global Supply Chains in a Post-Pandemic World
                                </a>
                            </li>
                            <li>
                                <a href="https://www.bloomberg.com/news/articles/2023-01-24/the-end-of-globalization-is-a-myth-that-is-already-busted" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors flex items-start gap-2">
                                    <span class="text-cyan-500 mt-1">&rarr;</span> Bloomberg: The End of Globalization Is a Myth
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-white/60 dark:border-white/5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.3)] rounded-3xl p-6 flex-1">
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-8 h-8 rounded-lg bg-cyan-50 dark:bg-cyan-900/30 flex items-center justify-center">
                                <BookOpen className="text-cyan-500" size={16} />
                            </div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Essential Books</h3>
                        </div>
                        <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-3">
                            <li>
                                <a href="https://freakonomics.com/books/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors flex items-start gap-2">
                                    <span class="text-cyan-500 mt-1">&rarr;</span> Freakonomics
                                </a>
                            </li>
                            <li>
                                <a href="https://timharford.com/books/undercovereconomist/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors flex items-start gap-2">
                                    <span class="text-cyan-500 mt-1">&rarr;</span> The Undercover Economist
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>