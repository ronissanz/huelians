---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GNEDHub | The Global Economy">
    <div class="flex-grow flex flex-col justify-center items-center text-center animate-fade-in relative pt-12 pb-24">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-600 text-xs font-semibold tracking-widest uppercase mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
            </span>
            GNED07 Module
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-slate-900 mb-6 leading-tight max-w-4xl">
            The mechanics of the <br/> 
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-cyan-400">global economy.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-600 max-w-2xl mb-12 font-light leading-relaxed">
            How GDP, inflation, central banks, and global trade actually dictate the world around you.
        </p>

        <a href="/modules" class="group relative inline-flex items-center justify-center px-8 py-3 text-sm font-semibold text-cyan-700 transition-all duration-200 bg-white/60 backdrop-blur-md border border-slate-200 rounded-full hover:bg-white hover:border-cyan-300 hover:shadow-[0_0_20px_rgba(6,182,212,0.1)]">
            Begin the Course
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
    </div>

    <!-- Quick Check Bottom Card -->
    <div class="mt-auto max-w-3xl w-full mx-auto">
        <div class="bg-white/60 backdrop-blur-md border border-slate-200 rounded-2xl p-6 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-cyan-500 to-cyan-200"></div>
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h3 class="text-sm font-medium text-cyan-600 mb-1 tracking-wide uppercase">Quick Check</h3>
                    <p class="text-slate-700 font-medium leading-relaxed">
                        If a country's real GDP shrinks for two consecutive quarters, what economic state has it officially entered?
                    </p>
                </div>
                
                <div class="shrink-0">
                    <button class="px-5 py-2.5 rounded-lg bg-white/80 border border-slate-200 text-sm font-medium text-slate-700 hover:bg-cyan-50 hover:border-cyan-300 hover:text-cyan-700 transition-all">
                        Reveal Answer
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>