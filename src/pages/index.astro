---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GNEDHub | The Connected World">
    <div class="flex-grow flex flex-col justify-center items-center text-center animate-fade-in relative pt-12 pb-24">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
            </span>
            GNED07 Module
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-white mb-6 leading-tight max-w-4xl">
            The hidden wiring of our <br/> 
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-cyan-200">connected World.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-400 max-w-2xl mb-12 font-light leading-relaxed">
            Strip away the academic jargon. Explore the massive, interconnected global machine spanning economics, assembly lines, and hyper-consumption.
        </p>

        <a href="/modules" class="group relative inline-flex items-center justify-center px-8 py-3 text-sm font-semibold text-white transition-all duration-200 bg-white/5 border border-white/10 rounded-full hover:bg-white/10 hover:border-cyan-500/50 hover:shadow-[0_0_20px_rgba(34,211,238,0.15)]">
            Begin the Curriculum
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
    </div>

    <!-- Quick Check Bottom Card -->
    <div class="mt-auto max-w-3xl w-full mx-auto">
        <div class="bg-white/[0.02] backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-cyan-400 to-transparent"></div>
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h3 class="text-sm font-medium text-cyan-400 mb-1 tracking-wide uppercase">Quick Check</h3>
                    <p class="text-slate-300 font-medium leading-relaxed">
                        According to István Benczés, which five key elements undergo continuous, cross-border movement in economic globalization?
                    </p>
                </div>
                
                <div class="shrink-0">
                    <button class="px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-sm font-medium hover:bg-cyan-500/10 hover:border-cyan-500/30 hover:text-cyan-300 transition-all">
                        Reveal Answer
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>