---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GNED Hub | Home">
	<main class="space-y-16 animate-in fade-in slide-in-from-bottom-4 duration-700 ease-in-out">
		
		<!-- Hero Section -->
		<header class="text-center py-12 md:py-20 space-y-6">
			<div class="inline-block px-3 py-1 mb-4 border border-cyan-500/30 rounded-full bg-cyan-500/10 text-cyan-300 text-xs font-semibold tracking-wider uppercase">
				Semester 2 • Cavite State University
			</div>
			<h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-cyan-100 to-cyan-400">
				General Education <br/> Resource Portal.
			</h1>
			<p class="max-w-2xl mx-auto text-lg text-slate-400 leading-relaxed">
				A centralized repository for syllabus copies, reading materials, and course notes for all core GNED subjects. 
			</p>
		</header>

		<!-- Quick Links Grid -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="p-8 rounded-2xl bg-slate-900 border border-white/5 hover:border-cyan-500/30 transition-colors group">
				<h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Latest Notes</h3>
				<p class="text-slate-400 text-sm">Review the most recently uploaded lecture slides and PDF documents.</p>
			</div>
			<div class="p-8 rounded-2xl bg-slate-900 border border-white/5 hover:border-cyan-500/30 transition-colors group">
				<h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Course Syllabus</h3>
				<p class="text-slate-400 text-sm">Download the comprehensive breakdown of grading systems and schedules.</p>
			</div>
		</section>
	</main>
</Layout>