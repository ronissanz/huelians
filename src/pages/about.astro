---
import Layout from '../layouts/Layout.astro';

const teamMembers = [
    {
        name: "Mark Aaron A. Mayor",
        role: "Backend & Cloud",
        edu: "4th-Year BS CS",
        github: "ynogiri",
        linkedin: "#"
    },
    ...Array(7).fill(null).map((_, i) => ({
        name: `Member 0${i + 2}`,
        role: "Frontend & UI",
        edu: "4th-Year BS CS",
        github: "#",
        linkedin: "#"
    }))
];
---

<Layout title="Syllabus & Creators | GNEDHub">
    <div class="flex flex-col lg:flex-row gap-12 items-start">
        
        <!-- Main Focus: Syllabus (70%) -->
        <div class="w-full lg:w-[70%] space-y-10">
            <div>
                <h1 class="text-4xl font-bold text-slate-900 tracking-tight mb-2">Syllabus Details</h1>
                <div class="h-px w-16 bg-cyan-500 mb-6"></div>
                <p class="text-slate-600 font-light text-base leading-relaxed mb-8 max-w-2xl">
                    GNED07: The Contemporary World. A structured exploration of the global economy, providing students with a deep understanding of GDP, inflation, monetary policy, and interconnected supply chains.
                </p>
            </div>

            <div class="bg-white/60 backdrop-blur-md border border-slate-200 rounded-2xl p-8 shadow-sm">
                <!-- Course Details -->
                <div class="space-y-4 mb-8">
                    <div class="flex justify-between items-center py-3 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500 uppercase tracking-wider">Course Code</span>
                        <span class="text-base font-semibold text-slate-900">GNED07</span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500 uppercase tracking-wider">Prerequisites</span>
                        <span class="text-base font-semibold text-slate-900">None</span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500 uppercase tracking-wider">Format</span>
                        <span class="text-base font-semibold text-slate-900">Digital Interactive</span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500 uppercase tracking-wider">Est. Completion</span>
                        <span class="text-base font-semibold text-cyan-600">4 Hours</span>
                    </div>
                </div>

                <!-- Assessment -->
                <div class="pt-2">
                    <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-5 flex items-center gap-2">
                        <div class="w-1.5 h-1.5 rounded-full bg-cyan-500"></div>
                        Assessment Breakdown
                    </h3>
                    <div class="space-y-3">
                        <div class="bg-white border border-slate-200 rounded-lg p-4 flex justify-between items-center hover:border-cyan-300 transition-colors">
                            <span class="text-sm font-medium text-slate-600">Quizzes</span>
                            <span class="text-sm font-bold text-slate-900">30%</span>
                        </div>
                        <div class="bg-white border border-slate-200 rounded-lg p-4 flex justify-between items-center hover:border-cyan-300 transition-colors">
                            <span class="text-sm font-medium text-slate-600">Essay</span>
                            <span class="text-sm font-bold text-slate-900">40%</span>
                        </div>
                        <div class="bg-cyan-50 border border-cyan-200 rounded-lg p-4 flex justify-between items-center relative overflow-hidden">
                            <div class="absolute inset-y-0 left-0 w-1 bg-cyan-500"></div>
                            <span class="text-sm font-semibold text-cyan-800 pl-2">Capstone Project</span>
                            <span class="text-sm font-bold text-cyan-600">30%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Secondary Focus: Team Profile (30%) -->
        <div class="w-full lg:w-[30%]">
            <h2 class="text-lg font-semibold text-slate-900 mb-6 flex items-center gap-2">
                Team Profiles
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">8</span>
            </h2>
            <div class="grid grid-cols-2 lg:grid-cols-1 gap-3">
                {teamMembers.map((member) => (
                    <div class="bg-white/60 backdrop-blur-md border border-slate-200 rounded-xl p-3 flex flex-col hover:border-cyan-300 hover:shadow-sm transition-all group">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xs font-bold text-slate-900 group-hover:text-cyan-700 transition-colors truncate pr-2" title={member.name}>{member.name}</h3>
                            <div class="flex gap-1.5 shrink-0">
                                <a href={member.github !== '#' ? `https://github.com/${member.github}` : '#'} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-900 transition-colors" aria-label="GitHub">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                                </a>
                                <a href={member.linkedin !== '#' ? `https://linkedin.com/in/${member.linkedin}` : '#'} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-cyan-600 transition-colors" aria-label="LinkedIn">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                                </a>
                            </div>
                        </div>
                        <p class="text-[10px] font-semibold text-cyan-600 mb-0.5">{member.role}</p>
                        <p class="text-[10px] text-slate-500 font-medium">{member.edu}</p>
                    </div>
                ))}
            </div>
        </div>
        
    </div>
</Layout>