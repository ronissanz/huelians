---
import Layout from '../layouts/Layout.astro';
import { Github, Linkedin, ExternalLink } from 'lucide-react';

const teamMembers = [
    {
        name: "Mark Aaron A. Mayor",
        role: "Backend & Cloud Platform Eng.",
        github: "ronissanz",
        linkedin: "mayormarkaaron"
    },
    {
        name: "Emanuel Lloyd Dagdag",
        role: "Frontend Specialization",
        github: "nhoonzies",
        linkedin: "emanuel-lloyd-dagdag"
    },
    ...Array(6).fill(null).map((_, i) => ({
        name: `Dev 0${i + 3}`,
        role: "Frontend Specialization",
        github: "github",
        linkedin: "#"
    }))
];
---

<Layout title="Syllabus & Creators | GNEDHub">
    <div class="flex flex-col lg:flex-row gap-10 items-start max-w-[1400px] w-full mx-auto px-6 py-24">
        
        <!-- Main Focus: Syllabus (75%) -->
        <div class="w-full lg:w-[75%] space-y-12">
            <div>
                <h1 class="text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">GNED07 Methodology</h1>
                <div class="h-1.5 w-24 bg-cyan-500 rounded-full mb-8 shadow-[0_0_10px_rgba(6,182,212,0.5)]"></div>
                <p class="text-slate-600 dark:text-slate-400 font-light text-xl leading-relaxed max-w-3xl">
                    The Contemporary World. A structured exploration of the global economy, providing students with a deep understanding of GDP, inflation, monetary policy, and interconnected supply chains via interactive data storytelling.
                </p>
            </div>

            <div class="bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-white/60 dark:border-white/5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.3)] rounded-3xl p-10">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 border-b border-slate-200 dark:border-slate-800 pb-4 gap-4">
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Course Structure</h2>
                    <div class="bg-cyan-50 dark:bg-cyan-900/30 border border-cyan-200 dark:border-cyan-800 px-4 py-2 rounded-lg">
                        <span class="text-xs font-bold text-cyan-700 dark:text-cyan-400 block tracking-widest uppercase">School Year: 2025-2026 | Section: BSCS 4B</span>
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 mb-12">
                    <div class="space-y-6">
                        <div>
                            <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-1">Course Code</span>
                            <span class="text-lg font-semibold text-slate-900 dark:text-white">GNED07</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-1">Prerequisites</span>
                            <span class="text-lg font-semibold text-slate-900 dark:text-white">None</span>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-1">Format</span>
                            <span class="text-lg font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                                Digital Interactive <span class="w-2 h-2 rounded-full bg-green-500"></span>
                            </span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-cyan-600 dark:text-cyan-500 uppercase tracking-widest block mb-1">Est. Completion</span>
                            <span class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">4 Hours</span>
                        </div>
                    </div>
                </div>

                <div class="pt-8 border-t border-slate-200 dark:border-slate-800">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-6 flex items-center gap-2">
                        <div class="w-1.5 h-1.5 rounded-full bg-cyan-500"></div>
                        Assessment Structure Matrix
                    </h3>
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl p-5 hover:-translate-y-1 transition-transform">
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 block mb-2">Module Quizzes</span>
                            <span class="text-3xl font-extrabold text-slate-900 dark:text-white">30%</span>
                        </div>
                        <div class="flex-1 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl p-5 hover:-translate-y-1 transition-transform">
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 block mb-2">Synthesis Essay</span>
                            <span class="text-3xl font-extrabold text-slate-900 dark:text-white">40%</span>
                        </div>
                        <div class="flex-1 bg-cyan-50 dark:bg-cyan-900/20 border border-cyan-200 dark:border-cyan-800/50 rounded-xl p-5 shadow-inner hover:-translate-y-1 transition-transform">
                            <span class="text-xs font-semibold text-cyan-700 dark:text-cyan-400 block mb-2">Capstone Project</span>
                            <span class="text-3xl font-extrabold text-cyan-600 dark:text-cyan-300">30%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Secondary Focus: Team Profile (25%) -->
        <div class="w-full lg:w-[25%] lg:pt-2">
            <div class="flex items-center justify-between mb-6 border-b border-slate-200 dark:border-slate-800 pb-3">
                <h2 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-widest">Engineering Team</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-900/50 text-cyan-700 dark:text-cyan-300 text-[10px] font-bold">8 ACTIVE</span>
            </div>
            
            <div class="flex flex-col gap-2">
                {teamMembers.map((member, i) => (
                    <div class={`bg-white/70 dark:bg-slate-900/60 backdrop-blur-sm border ${i === 0 ? 'border-cyan-200 dark:border-cyan-800/60 shadow-sm' : 'border-white/60 dark:border-white/5'} rounded-lg p-3 flex items-center gap-3 hover:border-cyan-400 dark:hover:border-cyan-600 transition-colors group`}>
                        <img 
                            src={`https://github.com/${member.github}.png`} 
                            alt={member.name} 
                            class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 object-cover bg-slate-100 dark:bg-slate-800 shrink-0"
                            loading="lazy"
                            onError={(e) => { e.currentTarget.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="%2394a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>' }}
                        />
                        <div class="flex flex-col min-w-0 flex-grow">
                            <h3 class={`text-[11px] font-bold truncate ${i === 0 ? 'text-cyan-700 dark:text-cyan-400' : 'text-slate-900 dark:text-slate-200'}`}>{member.name}</h3>
                            <p class="text-[9px] text-slate-500 dark:text-slate-400 font-medium truncate mb-1">{member.role}</p>
                            <div class="flex gap-2 shrink-0">
                                <a href={member.github !== '#' && member.github !== 'github' ? `https://github.com/${member.github}` : '#'} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="GitHub">
                                    <Github size={10} strokeWidth={2.5} />
                                </a>
                                <a href={member.linkedin !== '#' ? `https://linkedin.com/in/${member.linkedin}` : '#'} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors" aria-label="LinkedIn">
                                    <Linkedin size={10} strokeWidth={2.5} />
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
        
    </div>
</Layout>