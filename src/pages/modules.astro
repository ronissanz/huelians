---
import Layout from '../layouts/Layout.astro';

// Placeholder data for your subjects
const subjects = [
	{ code: 'GNED 01', title: 'Art Appreciation', desc: 'Exploring visual arts, humanities, and critical analysis of masterpieces.' },
	{ code: 'GNED 04', title: 'Mathematics in the Modern World', desc: 'Understanding the nature of mathematics and its application in daily life.' },
	{ code: 'GNED 08', title: 'Understanding the Self', desc: 'A multi-disciplinary approach to exploring identity and personal development.' },
	{ code: 'GNED 14', title: 'Philippine History', desc: 'Comprehensive analysis of primary sources and historical events.' },
];
---

<Layout title="GNED Hub | Modules">
	<main class="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
		
		<div class="border-b border-white/10 pb-6">
			<h1 class="text-4xl font-bold text-white mb-2">Subject Modules</h1>
			<p class="text-slate-400">Select a course to view its reading materials and assignments.</p>
		</div>

		<!-- Bento Grid for Subjects -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{subjects.map((subject) => (
				<a href="#" class="block p-6 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-900/50 border border-white/5 hover:border-white/20 transition-all hover:-translate-y-1 shadow-lg hover:shadow-cyan-500/10">
					<span class="text-cyan-400 text-sm font-bold tracking-wider">{subject.code}</span>
					<h2 class="text-2xl font-semibold text-white mt-1 mb-3">{subject.title}</h2>
					<p class="text-slate-400 text-sm leading-relaxed">{subject.desc}</p>
				</a>
			))}
		</div>

	</main>
</Layout>