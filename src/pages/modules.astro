---
import Layout from '../layouts/Layout.astro';

// Updated data for Cycle Theory Chapters
const chapters = [
	{ 
		id: '1', 
		title: 'Foundations and Early Growth', 
		desc: "This chapter explains that globalization isn't a straight line, but a repeating wave that rises and falls, introducing the fact that the average civilization only lasts about 275 years. It covers the very beginning of the cycle, showing how a global system kicks off through Phase Mixture (cultures blending) and Gestation (trade foundations settling) to build up early economic speed.",
		featured: true
	},
	{ 
		id: '2', 
		title: 'Expansion and Peak Hubris', 
		desc: 'This section focuses on the golden age of the cycle and the dangerous turning point that follows. It details the Expansion and Prosperity phase where borders open and wealth grows, but quickly transitions into Conflict, Overshoot, and Hubris, showing what happens when dominant powers get too big and push the system past its structural limits.' 
	},
	{ 
		id: '3', 
		title: 'Totalitarian Control and Collapse', 
		desc: 'This chapter looks at the final dark stages of the cycle where the failing system completely breaks down. It breaks down the Totalitarian phase, explaining how ruling elites use extreme regulations to desperately hold onto power, and shows why these forced measures inevitably fail and lead to a total structural collapse that resets the clock.' 
	},
	{ 
		id: '4', 
		title: 'The Modern Cycle Case Study', 
		desc: "The final chapter applies this entire four-chapter framework directly to our world today as a real-world test case. By tracking our current globalization cycle from its start at the Peace of Westphalia in 1648, it proves that our current global financial drama and political chaos aren't random accidents—they happen because our system is 375 years old and well past its expiration date." 
	},
];
---

<Layout title="GNED07 | Course Modules">
	<main class="space-y-12 animate-in fade-in slide-in-from-bottom-8 duration-700 mt-8 max-w-7xl mx-auto px-6">
		
		<div class="border-b border-white/10 pb-8 relative">
			<div class="absolute -top-10 -left-10 w-64 h-64 bg-cyan-500/10 blur-[80px] rounded-full pointer-events-none z-[-1]"></div>
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
				Course <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Chapters.</span>
			</h1>
			<p class="text-lg text-slate-400 max-w-2xl">
				Navigate through the core concepts of Cycle Theory. Select a module below to begin reading the interactive materials.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-24">
			{chapters.map((chapter) => (
				<a 
					href={`/chapters/${chapter.id}`} 
					class={`group relative block p-8 rounded-3xl bg-slate-900/50 backdrop-blur-sm border border-white/5 hover:border-cyan-500/30 transition-all duration-300 hover:-translate-y-1 overflow-hidden
						${chapter.featured ? 'md:col-span-2 bg-gradient-to-br from-slate-900 to-slate-800' : 'md:col-span-1'}
					`}
				>
					<div class="absolute inset-0 bg-gradient-to-br from-cyan-500/0 via-cyan-500/0 to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
					
					<div class="relative z-10 flex flex-col h-full justify-between">
						<div>
							<span class="inline-block px-3 py-1 rounded-full bg-slate-950 border border-white/10 text-cyan-400 text-xs font-bold tracking-widest mb-6 shadow-inner">
								CHAPTER {chapter.id}
							</span>
							<h2 class={`font-bold text-white mb-4 leading-snug group-hover:text-cyan-300 transition-colors ${chapter.featured ? 'text-3xl md:text-4xl' : 'text-2xl'}`}>
								{chapter.title}
							</h2>
						</div>
						
						<div class="mt-8 flex items-center text-sm font-medium text-cyan-400 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
							Read Chapter <span aria-hidden="true" class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
						</div>
					</div>
				</a>
			))}
		</div>

	</main>
</Layout>