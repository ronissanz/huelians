---
import Layout from '../layouts/Layout.astro';
import AnimatedCards from '../components/AnimatedCards.tsx';
---

<Layout title="GNED07 | Course Modules">
	<main class="space-y-12 animate-in fade-in slide-in-from-bottom-8 duration-700 mt-8 max-w-7xl mx-auto px-6">
		
		<div class="border-b border-white/10 pb-8 relative">
			<div class="absolute -top-10 -left-10 w-64 h-64 bg-cyan-500/10 blur-[80px] rounded-full pointer-events-none z-[-1]"></div>
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
				Course <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Chapters.</span>
			</h1>
			<p class="text-lg text-slate-400 max-w-2xl">
				Navigate through the core concepts of Cycle Theory. Select a module below to begin reading the interactive materials.
			</p>
		</div>

		<AnimatedCards client:load />

	</main>
</Layout>