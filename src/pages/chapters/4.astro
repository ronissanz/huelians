---
import Layout from '../../layouts/Layout.astro';
import { ScrollProgress, AnimatedChapterContent } from '../../components/ChapterAnimations.tsx';
---

<Layout title="Chapter 4: The Modern Cycle Case Study">
	<ScrollProgress client:load />
	<main class="mt-8 max-w-4xl mx-auto px-6 pb-24">
		<AnimatedChapterContent client:load>
			<div class="space-y-12">
				<a href="/modules" class="inline-flex items-center text-sm font-medium text-slate-400 hover:text-cyan-400 transition-colors">
					<span aria-hidden="true" class="mr-2">←</span> Back to Modules
				</a>

				<div class="space-y-4">
					<span class="inline-block px-3 py-1 rounded-full bg-slate-950 border border-white/10 text-cyan-400 text-xs font-bold tracking-widest shadow-inner">
						CHAPTER 4
					</span>
					<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white drop-shadow-[0_0_15px_rgba(6,182,212,0.3)]">
						The Modern Cycle Case Study
					</h1>
				</div>

				<div class="prose prose-invert prose-slate prose-cyan lg:prose-xl max-w-none">
					<div class="space-y-6">
						<div class="p-6 rounded-2xl bg-slate-900/50 border border-white/5 hover:border-cyan-500/30 transition-colors shadow-lg">
							<h3 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-cyan-300 mb-2">Application of Phases 1 to 7</h3>
							<p class="text-slate-300 leading-relaxed font-light m-0">This chapter walks through our actual world history from 1648 to today. It proves we have already lived through the early phases and uses the framework to show how our current global chaos is a sign that we are currently sliding out of Phase 5 (Hubris) and deep into Phase 6 (Decay).</p>
						</div>
					</div>
				</div>
			</div>
		</AnimatedChapterContent>
	</main>
</Layout>
